{
  "name": "fern-application",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt --write src tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format:check": "oxfmt --check src tests scripts vite.config.ts",
    "verify": "node scripts/verify.mjs",
    "verify:core": "node scripts/verify.mjs --core",
    "export:portal": "node scripts/export-portal.mjs",
    "test:portal-handover": "node tests/portal-handover-browser.mjs",
    "test:browser:pdf": "node tests/pdf-delivery-browser.mjs"
  },
  "dependencies": {
    "@cloudscape-design/components": "^3.0.1407",
    "@cloudscape-design/design-tokens": "^3.0.117",
    "@cloudscape-design/global-styles": "^1.0.71",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "0.75.0",
    "playwright": "1.64.1",
    "sass": "^1.107.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0"
